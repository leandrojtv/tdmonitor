# Ambiente geral
NODE_ENV=development

# Frontend
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:3001/api

# Backend
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost
ENCRYPTION_KEY=12345678901234567890123456789012
TERADATA_TIMEOUT_MS=30000
CACHE_TTL_MINUTES=15

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=td_monitor
POSTGRES_USER=td_monitor_user
POSTGRES_PASSWORD=td_monitor_pass

# Backend DB connection (interno do container)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=td_monitor_user
DB_PASSWORD=td_monitor_pass
DB_DATABASE=td_monitor

# Teradata JDBC
TERADATA_USERNAME=dbc
TERADATA_PASSWORD=dbc
TERADATA_JDBC_DRIVER_CLASS=com.teradata.jdbc.TeraDriver
TERADATA_JDBC_JAR_PATH=/opt/teradata/jdbc/terajdbc4.jar
